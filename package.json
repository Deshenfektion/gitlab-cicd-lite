{
  "name": "gitlab-cicd-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A miniature CI/CD platform inspired by GitLab CI",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "~9.34.0",
    "@types/node": "~22.15.3",
    "eslint": "~9.34.0",
    "eslint-config-prettier": "~10.1.5",
    "pino-pretty": "~13.1.1",
    "prettier": "~3.6.2",
    "tsx": "~4.20.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "~8.41.0",
    "vitest": "~3.2.4"
  }
}
